# DB_HOST y DB_PORT los fija el compose (postgres:5432); aplican si ejecutas la aplicación fuera de Docker.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Ejemplo: mongodb://usuario:clave@host:27017/base?authSource=admin
MONGO_URI=
# Mínimo 32 caracteres
JWT_SECRET=
# Opcionales: si ambos tienen valor, se crea un ADMIN inicial al arrancar
ADMIN_CORREO=
ADMIN_CONTRASENA=
# Opcional: días que se conservan los logs en MongoDB (por defecto 30)
# LOGS_RETENCION_DIAS=30
