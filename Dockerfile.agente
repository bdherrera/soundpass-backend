# Contenedor del agente: Claude Code + JDK 21 + Maven + Node.
# Corre sin privilegios (usuario node). No tiene acceso al socket de Docker ni credenciales de GitHub.
FROM node:22-bookworm-slim

ARG MAVEN_VERSION=3.9.9
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:/opt/maven/bin:${PATH}"

RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates bash \
 && rm -rf /var/lib/apt/lists/*

COPY --from=eclipse-temurin:21-jdk /opt/java/openjdk /opt/java/openjdk

RUN curl -fsSL "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" \
    | tar -xz -C /opt \
 && mv "/opt/apache-maven-${MAVEN_VERSION}" /opt/maven

RUN npm install -g @anthropic-ai/claude-code

RUN git config --system --add safe.directory /work \
 && mkdir -p /work /home/node/.m2 \
 && chown -R node:node /work /home/node/.m2

USER node
WORKDIR /work
ENV HOME=/home/node
ENV JAVA_TOOL_OPTIONS="-Xmx768m"
CMD ["bash"]
